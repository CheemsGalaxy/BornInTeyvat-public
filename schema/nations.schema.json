{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CheemsGalaxy/BornInTeyvat-public/main/schema/nations.schema.json",
  "title": "BornInTeyvat Public Nation Dataset",
  "description": "Nation records for the Born in Teyvat public dataset.",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable kebab-case identifier. Must not change once published."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Nation display name."
      },
      "element": {
        "type": "string",
        "description": "Element associated with the nation. Omitted when no element has been published.",
        "enum": [
          "Anemo",
          "Cryo",
          "Dendro",
          "Electro",
          "Geo",
          "Hydro",
          "Pyro"
        ]
      }
    }
  }
}
