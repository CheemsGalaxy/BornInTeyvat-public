{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CheemsGalaxy/BornInTeyvat-public/main/schema/characters.schema.json",
  "title": "BornInTeyvat Public Character Dataset",
  "description": "Character birthday records for the Born in Teyvat public dataset.",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "birthday",
      "element",
      "nation",
      "rarity"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable kebab-case identifier. Must not change once published."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Character display name."
      },
      "birthday": {
        "type": "string",
        "description": "Birthday in MM-DD format. February 29 is valid.",
        "oneOf": [
          {
            "pattern": "^01-(0[1-9]|[12][0-9]|3[01])$"
          },
          {
            "pattern": "^02-(0[1-9]|1[0-9]|2[0-9])$"
          },
          {
            "pattern": "^03-(0[1-9]|[12][0-9]|3[01])$"
          },
          {
            "pattern": "^04-(0[1-9]|[12][0-9]|30)$"
          },
          {
            "pattern": "^05-(0[1-9]|[12][0-9]|3[01])$"
          },
          {
            "pattern": "^06-(0[1-9]|[12][0-9]|30)$"
          },
          {
            "pattern": "^07-(0[1-9]|[12][0-9]|3[01])$"
          },
          {
            "pattern": "^08-(0[1-9]|[12][0-9]|3[01])$"
          },
          {
            "pattern": "^09-(0[1-9]|[12][0-9]|30)$"
          },
          {
            "pattern": "^10-(0[1-9]|[12][0-9]|3[01])$"
          },
          {
            "pattern": "^11-(0[1-9]|[12][0-9]|30)$"
          },
          {
            "pattern": "^12-(0[1-9]|[12][0-9]|3[01])$"
          }
        ]
      },
      "element": {
        "type": "string",
        "description": "Character element.",
        "enum": [
          "Anemo",
          "Cryo",
          "Dendro",
          "Electro",
          "Geo",
          "Hydro",
          "Pyro"
        ]
      },
      "nation": {
        "type": "string",
        "description": "Character nation. Other is a classification for characters without a listed nation record.",
        "enum": [
          "Fontaine",
          "Inazuma",
          "Liyue",
          "Mondstadt",
          "Natlan",
          "Nod-Krai",
          "Other",
          "Snezhnaya",
          "Sumeru"
        ]
      },
      "rarity": {
        "type": "integer",
        "description": "Character rarity in stars.",
        "enum": [
          4,
          5
        ]
      }
    }
  }
}
